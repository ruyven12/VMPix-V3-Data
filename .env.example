# Render will provide PORT automatically. Local default is 3000.
PORT=3000

# PostgreSQL connection string from Render.
DATABASE_URL=

# Required before exposing admin/import routes on Render.
ADMIN_TOKEN=

# Optional legacy/admin compatibility. Prefer ADMIN_TOKEN for new setup.
ADMIN_PASSWORD=

# Optional: force admin token checks in local development.
ADMIN_REQUIRE_TOKEN=0

# Google Sheet ID from the VMPix Master Data sheet URL.
# Example URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=

# Optional CORS allowlist, comma-separated.
# Leave blank to allow public non-credentialed GET requests.
# When set, admin/control routes only grant browser CORS access to listed origins.
CORS_ALLOW_ORIGINS=https://vmpix.onrender.com,https://vmpix.smugmug.com

# Sheet tab GIDs. Fill these in after each tab is published or copied from its URL.
GID_MUSIC_BANDS=
GID_MUSIC_SHOWS=
GID_MUSIC_PEOPLE=
GID_MUSIC_VENUES=
GID_WRESTLING_MATCHES=
GID_WRESTLING_PEOPLE=
GID_WRESTLING_VENUES=
GID_STATS=

# Legacy sheet-backed route only, if that route remains in use.
GID_WRESTLING_SHOWS=

# Optional import/admin tuning.
IMPORT_LOCK_TTL_MS=1800000
IMPORT_STALE_WARNING_HOURS=168
IMPORT_DEBUG=0

# Optional SmugMug integration for Music metadata/photo counts.
SMUG_API_KEY=
SMUG_NICKNAME=vmpix
SMUG_USER_AGENT=VMPix-V3-Data/1.0
SMUG_REQUEST_RETRIES=2
SMUG_RETRY_DELAY_MS=1500
SMUG_REQUEST_CONCURRENCY=2
SMUG_TOTAL_PHOTOS_CACHE_TTL_MS=43200000


# Calendar integration and public exposure both default off; enable separately with approval.
# The project ID, approval label, New York timezone and 5-minute ceiling are fixed in code.
# Master integration: only 1 enables OAuth and refresh. This does not authorize public exposure.
TODOIST_CALENDAR_ENABLED=0
# Public API: only true or 1 enables visibility, and the master must also be enabled/configured.
# Keep false during private validation. Set false for public-disable rollback; retain credentials.
# Flags are read at process startup; apply approved environment changes to all running instances.
TODOIST_CALENDAR_PUBLIC_ENABLED=false
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Base64 encoding of exactly 32 random bytes, provisioned through deployment secrets.
TODOIST_TOKEN_ENCRYPTION_KEY=
# Exact registered URI, ending in /api/calendar/oauth/callback; HTTPS in production.
TODOIST_REDIRECT_URI=
