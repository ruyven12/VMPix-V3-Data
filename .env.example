# Render will provide PORT automatically. Local default is 3000.
PORT=3000

# Google Sheet ID from the VMPix Master Data sheet URL.
# Example URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=

# Optional CORS allowlist, comma-separated.
# Leave blank to allow public non-credentialed GET requests.
CORS_ALLOW_ORIGINS=https://vmpix.onrender.com,https://vmpix.smugmug.com

# Sheet tab GIDs. Fill these in after each tab is published or copied from its URL.
GID_MUSIC_BANDS=
GID_MUSIC_SHOWS=
GID_MUSIC_PEOPLE=
GID_MUSIC_VENUES=
GID_WRESTLING_SHOWS=
GID_WRESTLING_PEOPLE=
GID_WRESTLING_VENUES=
GID_STATS=
